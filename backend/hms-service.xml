<service>
  <id>VyaptekHMS</id>
  <name>Vyaptek HMS</name>
  <description>Runs the Spring Boot backend for the hospital.</description>
  <!-- The installer's own Java runtime ({app}\jre), not %JAVA_HOME%: another Java installed on the
       PC later can change JAVA_HOME, and the backend is built for Java 25. -->
  <executable>%BASE%\..\jre\bin\java.exe</executable>
  <!-- java.io.tmpdir: a folder only this service (NT SERVICE\VyaptekHMS), SYSTEM and Administrators can
       open, made by service-accounts.ps1. LibreOffice's per-process profiles go under it too. -->
  <arguments>-Xmx512m -Djava.io.tmpdir="%ProgramData%\Vyaptek\HMS\temp" -jar "%BASE%\hms.jar"</arguments>
  <!-- Spring Boot reads config\application.properties (this box's secrets, written by
       write-secrets.ps1) relative to the working directory, so pin it to this folder. -->
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <!-- Off: with it on, WinSW re-applies this file whenever it is newer than the service's registry
       entry, at every start, and to do that it opens its own service with full access. The service's
       own account (NT SERVICE\VyaptekHMS) has no such access, so every start failed: "Failed to open
       the service. Access is denied", error 1053. hms.iss runs "hms-service.exe refresh" as an
       administrator instead. -->
  <autoRefresh>false</autoRefresh>

  <!-- Wait for PostgreSQL and the cache server (Garnet) before starting. The EDB installer registers
       PostgreSQL 18 as "postgresql-x64-18" on 64-bit Windows by default. "install" applies these only
       when it creates the service; hms.iss runs "refresh" on every run for one that already exists. -->
  <depend>postgresql-x64-18</depend>
  <depend>VyaptekGarnet</depend>

  <!-- If startup still fails (e.g. PG accepted the connection after SCM reported
       Running), retry up to three times before giving up. -->
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="20 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>

  <log mode="roll"></log>
  <logpath>%BASE%\logs</logpath>
  <env name="DB_URL"      value="jdbc:postgresql://127.0.0.1:5432/hospital_erp"/>
  <!-- No account or password here: this file is readable by every local user. The backend's account
       (hospital_erp_user) and its password are in config\application.properties, written by
       write-secrets.ps1; without them the backend does not start (backend plan 24 section 11, OP1 and
       OP8). It used to fall back to the superuser with the password "admin". -->
  <!-- Garnet speaks the Redis protocol, so the backend's Redis settings point at it. 127.0.0.1, not
       localhost: Garnet listens on IPv4 loopback only (garnet.conf), and localhost may resolve to ::1. -->
  <env name="REDIS_HOST"  value="127.0.0.1"/>
  <env name="REDIS_PORT"  value="6379"/>
  <!-- Only nginx on this machine reaches the backend (backend plan 24, I4). The relay pull worker
       replays callbacks to localhost, which this still serves. -->
  <env name="SERVER_ADDRESS" value="127.0.0.1"/>
  <!-- Uploaded report files (backend plan 24 section 11, OP3). Until 2026-10 nothing set this and they went
       to C:\data\uploads, which every signed-in user could change; service-accounts.ps1 moves them here
       once and locks the folder to this service. -->
  <env name="FILE_STORAGE_DIR" value="%ProgramData%\Vyaptek\HMS\uploads"/>
  <!-- Every uploaded file is scanned by Microsoft Defender before it is stored (backend plan 24 section
       12.2, N18). If the hospital's own antivirus has made Defender passive, uploads are refused (503)
       until this is set to none, or to clamd with HMS_CLAMD_HOST pointing at a ClamAV daemon. -->
  <env name="HMS_UPLOAD_SCAN" value="defender"/>
</service>